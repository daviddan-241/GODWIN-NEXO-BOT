# Dependencies
node_modules/

# Build output — dist/src + dist/assets are COMMITTED as a prebuilt
# fallback so hosts without a build step (`node src/index.js`) still work.
dist/*
!dist/src/
!dist/assets/
!dist/src/**
!dist/assets/**
coverage/

# Environment — never commit real credentials
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/

# Secrets (private keys, keystores, dumps)
*.pem
*.key
*.keystore
*.p12
wallet-export*
secrets/
*.sql.dump

# Local test artifacts
tmp/
