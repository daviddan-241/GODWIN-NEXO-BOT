{
  "name": "hfive-bot",
  "version": "1.7.1",
  "description": "Hfive — production-ready Solana trading Telegram bot (real RPC, real swaps via Jupiter, PostgreSQL, encrypted wallets)",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "check:env": "tsx scripts/check-env.ts",
    "build:prebuilt": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@grammyjs/types": "^3.9.0",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.98.0",
    "bip39": "^3.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "ed25519-hd-key": "^1.3.0",
    "grammy": "^1.34.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "main": "dist/src/index.js"
}
