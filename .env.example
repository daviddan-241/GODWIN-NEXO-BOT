# =========================================================================
# Nexo Snipe — Solana trading Telegram bot
# Copy this file to .env and fill in real values. NEVER commit .env.
# Every value here is read from the environment at runtime.
# =========================================================================

# -------------------------------------------------------------------------
# Telegram
# -------------------------------------------------------------------------
# Bot token from @BotFather. Required.
BOT_TOKEN=

# Comma-separated Telegram chat IDs that receive admin notifications.
# Supports multiple IDs: 123456789,987654321. Required.
# OWNER_TELEGRAM_ID (single ID) is accepted as an alias.
ADMIN_IDS=

# Product name shown to users (default: Nexo Snipe).
# APP_NAME=Nexo Snipe

# -------------------------------------------------------------------------
# Branding / links (help screen)
# -------------------------------------------------------------------------
SUPPORT_USERNAME=@ainexobotsupport
WEBSITE_URL=https://t.co/z1XgC7Zd6d
TWITTER_URL=https://x.com/Nexo?s=20

# -------------------------------------------------------------------------
# Trade gate
# -------------------------------------------------------------------------
# Minimum SOL balance required to trade (verified against the real RPC).
MIN_SOL_BALANCE=3.0000

# -------------------------------------------------------------------------
# Solana
# -------------------------------------------------------------------------
# "devnet" or "mainnet". Default: devnet.
SOLANA_NETWORK=devnet

# MAINNET SAFETY GATE: real mainnet transactions are possible ONLY when
# SOLANA_NETWORK=mainnet AND SOLANA_MAINNET_ENABLED=true.
SOLANA_MAINNET_ENABLED=false

# Optional RPC endpoint override (private RPC recommended for mainnet).
# SOLANA_RPC_URL=

# Optional WebSocket endpoint: wakes the deposit monitor on account
# changes. Polling remains authoritative either way.
# SOLANA_WS_URL=

# RPC commitment level: "confirmed" or "finalized".
# Deposits are notified only after the delta persists across
# DEPOSIT_CONFIRMATION_POLLS at this commitment (anti-reorg).
COMMITMENT=confirmed
DEPOSIT_CONFIRMATION_POLLS=2

# -------------------------------------------------------------------------
# Wallet security
# -------------------------------------------------------------------------
# Secret that encrypts every wallet secret at rest (AES-256-GCM).
# Use 64 hex characters (32 bytes) or a long random passphrase.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Optional owner seed phrase: the bot derives it at startup and logs ONLY
# the public address. The seed itself is never stored or logged.
# SEED_PHRASE=

# -------------------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------------------
DATABASE_URL=postgres://hfive:hfive@localhost:5432/hfive

# -------------------------------------------------------------------------
# Market data
# -------------------------------------------------------------------------
COINGECKO_API_URL=https://api.coingecko.com/api/v3
DEXSCREENER_API_URL=https://api.dexscreener.com

# -------------------------------------------------------------------------
# Trading
# -------------------------------------------------------------------------
JUPITER_QUOTE_API_URL=https://quote-api.jup.ag/v6
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v2
DEFAULT_SLIPPAGE_BPS=100
# Hard cap per single trade, in SOL (covers the sniper range 0.0001–1000).
TRADING_MAX_SOL_PER_TRADE=1000
# Deposit monitor poll interval (ms).
DEPOSIT_POLL_INTERVAL_MS=30000

# -------------------------------------------------------------------------
# Hardening
# -------------------------------------------------------------------------
# Stale conversation flows reset to idle after this many ms.
CONVERSATION_TIMEOUT_MS=600000
# Per-chat rate limiting (updates per window).
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=10000

# -------------------------------------------------------------------------
# HTTP health server (UptimeRobot: GET / or /health -> "OK")
# -------------------------------------------------------------------------
HEALTHCHECK_ENABLED=true
PORT=8080
LOG_LEVEL=info
